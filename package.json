{
  "name": "neurosight-ai",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Experimental, entirely local webcam pupillometry and eye tracking research prototype",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "setup:assets": "node scripts/setup-assets.mjs",
    "test:engine": "node --experimental-strip-types --test tests/*.test.mjs",
    "postinstall": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/react": "18.3.22",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "5.4.19"
  },
  "engines": {"node": ">=18.0.0"}
}
